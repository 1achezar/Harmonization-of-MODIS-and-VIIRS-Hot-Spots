@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NasaSpaceAppsChallenge – MODIS + VIIRS Harmonization</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            space: { 950: '#060b19', 900: '#0b1224', 800: '#111a33' }
          }
        }
      }
    };
  </script>

  <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { background-color: #060b19; overflow-x: hidden; }

    /* animated fire pulse on globe SVG hotspots */
    .fire-dot { animation: pulse 2.2s ease-in-out infinite; }
    .fire-dot:nth-child(2) { animation-delay: .6s; }
    .fire-dot:nth-child(3) { animation-delay: 1.1s; }
    @@keyframes pulse {
      0%, 100% { opacity: .9; r: 4; }
      50%       { opacity: .3; r: 6; }
    }

    /* globe hover glow */
    .globe-wrapper:hover .balkan-globe { filter: drop-shadow(0 0 55px rgba(0,229,255,.22)); }
    .balkan-globe { transition: filter .5s; filter: drop-shadow(0 0 32px rgba(0,229,255,.12)); }

    /* stat card shimmer on hover */
    .stat-card { transition: border-color .2s, background .2s; }
    .stat-card:hover { background: rgba(17,26,51,.8); border-color: rgba(34,211,238,.18); }
  </style>
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-cyan-500/30 selection:text-cyan-200">

  <!-- ══════════════════════ NAV ══════════════════════ -->
  <header class="sticky top-0 z-50 bg-space-950/85 backdrop-blur-md border-b border-slate-800/80">
    <div class="w-full px-6 sm:px-10 h-16 flex items-center justify-between gap-4">

      <a href="#top" class="flex items-center gap-3 group">
        <div class="w-9 h-9 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 group-hover:border-cyan-400 transition">
          <i data-lucide="satellite" class="w-5 h-5"></i>
        </div>
        <div>
          <div class="font-bold text-sm sm:text-base tracking-tight text-white leading-none">NasaSpaceAppsChallenge</div>
          <div class="text-[11px] text-slate-500 font-mono mt-0.5">MODIS + VIIRS Harmonized Burning Activity</div>
        </div>
      </a>

      <nav class="flex items-center gap-2">
        <a href="#about" class="hidden sm:block px-3 py-1.5 rounded-lg text-xs text-slate-400 hover:text-slate-200 transition">About</a>
        <a href="/Home/Globe"
           class="px-4 py-2 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs sm:text-sm transition
                  shadow-lg shadow-cyan-500/20 flex items-center gap-2">
          <i data-lucide="globe" class="w-4 h-4"></i>
          <span>Open Globe</span>
        </a>
      </nav>
    </div>
  </header>

  <!-- ══════════════════════ HERO ══════════════════════ -->
  <section id="top" class="relative overflow-hidden border-b border-slate-800/80 flex-1 flex items-center min-h-[calc(100vh-4rem)]">

    <!-- ambient glows -->
    <div class="pointer-events-none absolute -top-32 -left-32 w-[520px] h-[520px] rounded-full bg-cyan-500/5 blur-[100px]"></div>
    <div class="pointer-events-none absolute bottom-0 right-10 w-[400px] h-[400px] rounded-full bg-orange-500/6 blur-[90px]"></div>

    <div class="max-w-7xl mx-auto px-6 py-16 lg:py-24 w-full grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">

      <!-- ── LEFT ── -->
      <div class="lg:col-span-6 space-y-8 z-10">

        <!-- badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-orange-500/30 bg-orange-500/8 text-orange-400 text-xs font-mono">
          <span class="w-1.5 h-1.5 rounded-full bg-orange-400 animate-pulse"></span>
          NASA Space Apps Challenge 2024
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-extrabold tracking-tight text-white leading-[1.07]">
          Wildfires on the<br>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 via-amber-400 to-red-500">
            Balkans
          </span>
        </h1>

        <p class="text-base sm:text-lg text-slate-400 max-w-xl leading-relaxed">
          Harmonize the long historical record of <span class="text-slate-200 font-medium">MODIS (1 km)</span> with the
          precision of <span class="text-slate-200 font-medium">VIIRS (375 m)</span> into a single
          <span class="text-cyan-400 font-semibold">FireActivityCalendar</span> — covering the Balkan Peninsula from 2000 to 2026.
        </p>

        <!-- CTA row -->
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a href="/Home/Globe"
             class="px-6 py-3.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-sm transition
                    shadow-xl shadow-cyan-500/20 flex items-center gap-2">
            <i data-lucide="globe" class="w-4 h-4"></i>
            Launch Interactive Globe
          </a>
          <a href="#about"
             class="px-5 py-3.5 rounded-xl border border-slate-700 hover:border-slate-600 text-slate-300 hover:text-white
                    text-sm font-medium transition flex items-center gap-2">
            <i data-lucide="info" class="w-4 h-4"></i>
            Learn More
          </a>
        </div>

        <!-- stat strip -->
        <div class="grid grid-cols-3 gap-3 pt-2 border-t border-slate-800/60 max-w-lg">
          <div class="stat-card p-3.5 rounded-xl bg-space-800/50 border border-slate-800/80">
            <div class="text-lg font-bold font-mono text-white">2000–<br>2026</div>
            <div class="text-[11px] text-slate-500 mt-0.5">Time span</div>
          </div>
          <div class="stat-card p-3.5 rounded-xl bg-space-800/50 border border-slate-800/80">
            <div class="text-lg font-bold font-mono text-orange-400">959K+</div>
            <div class="text-[11px] text-slate-500 mt-0.5">Fire records</div>
          </div>
          <div class="stat-card p-3.5 rounded-xl bg-space-800/50 border border-slate-800/80">
            <div class="text-lg font-bold font-mono text-cyan-400">2 sensors</div>
            <div class="text-[11px] text-slate-500 mt-0.5">MODIS + VIIRS</div>
          </div>
        </div>
      </div>

      <!-- ── RIGHT: animated SVG globe ── -->
      <div class="lg:col-span-6 flex items-center justify-center z-10">
        <a href="/Home/Globe" aria-label="Open interactive 3D globe" class="globe-wrapper group w-full max-w-[460px]">
          <svg class="balkan-globe w-full h-full" viewBox="0 0 420 420" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <!-- sphere gradient -->
              <radialGradient id="sphereGlow" cx="38%" cy="35%" r="62%">
                <stop offset="0%"   stop-color="#0d2545" stop-opacity="1" />
                <stop offset="60%"  stop-color="#060b19" stop-opacity="1" />
                <stop offset="100%" stop-color="#020408" stop-opacity="1" />
              </radialGradient>
              <!-- fire glow -->
              <radialGradient id="fireGlow" cx="50%" cy="50%" r="50%">
                <stop offset="0%"   stop-color="#f97316" stop-opacity="1" />
                <stop offset="100%" stop-color="#f97316" stop-opacity="0" />
              </radialGradient>
              <clipPath id="globeClip">
                <circle cx="210" cy="210" r="175" />
              </clipPath>
            </defs>

            <!-- outer ring glow -->
            <circle cx="210" cy="210" r="184" fill="none" stroke="#00E5FF" stroke-opacity="0.06" stroke-width="2" />

            <!-- globe sphere -->
            <circle cx="210" cy="210" r="175"
                    fill="url(#sphereGlow)"
                    stroke="#00E5FF" stroke-opacity="0.35" stroke-width="1.5" />

            <g clip-path="url(#globeClip)">

              <!-- latitude rings -->
              <g stroke="#00E5FF" stroke-opacity="0.12" stroke-width="0.9" fill="none">
                <ellipse cx="210" cy="95"  rx="134" ry="22" />
                <ellipse cx="210" cy="150" rx="164" ry="30" />
                <ellipse cx="210" cy="210" rx="175" ry="36" stroke-opacity="0.20" />
                <ellipse cx="210" cy="270" rx="164" ry="30" />
                <ellipse cx="210" cy="325" rx="134" ry="22" />
              </g>

              <!-- longitude arcs -->
              <g stroke="#00E5FF" stroke-opacity="0.10" stroke-width="0.9" fill="none">
                <ellipse cx="210" cy="210" rx="42"  ry="175" />
                <ellipse cx="210" cy="210" rx="95"  ry="175" />
                <ellipse cx="210" cy="210" rx="142" ry="175" />
                <line x1="210" y1="35" x2="210" y2="385" stroke-opacity="0.18" />
              </g>

              <!-- landmasses -->
              <g fill="#00E5FF" fill-opacity="0.05" stroke="#00E5FF" stroke-opacity="0.22" stroke-width="1.1" stroke-linejoin="round">
                <!-- W + N Europe / Scandinavia -->
                <path d="M155,112 L166,95 L182,82 L198,86 L194,104 L180,115 L186,126 L172,135 L154,142 L144,132 Z" />
                <!-- Iberian -->
                <path d="M142,143 L156,143 L154,156 L140,155 Z" />
                <!-- Italian -->
                <path d="M174,136 L183,138 L190,154 L184,158 L176,144 Z" />
                <!-- Balkans highlight -->
                <path d="M192,136 L214,135 L224,146 L216,158 L207,168 L199,163 L194,148 Z"
                      fill="#00E5FF" fill-opacity="0.14" stroke="#22d3ee" stroke-opacity="0.5" />
                <!-- E Europe + Asia -->
                <path d="M202,96 L248,88 L312,98 L358,124 L366,162 L338,188 L302,184 L282,202 L262,182 L242,164 L218,142 L202,126 Z" />
                <!-- Africa -->
                <path d="M144,166 L186,166 L216,184 L232,218 L222,262 L202,298 L184,294 L176,248 L152,226 L136,196 Z" />
                <!-- Americas limb -->
                <path d="M46,118 L78,108 L92,136 L76,168 L88,196 L112,224 L98,274 L76,294 L66,244 L52,188 Z" />
              </g>

              <!-- fire hotspots (animated) -->
              <g>
                <!-- Strandzha -->
                <circle class="fire-dot" cx="221" cy="148" r="4" fill="#f97316" fill-opacity="0.9" />
                <circle cx="221" cy="148" r="8" fill="url(#fireGlow)" fill-opacity="0.4" />
                <!-- Dadia -->
                <circle class="fire-dot" cx="208" cy="156" r="4" fill="#ef4444" fill-opacity="0.9" />
                <circle cx="208" cy="156" r="9" fill="url(#fireGlow)" fill-opacity="0.35" />
                <!-- Sakar -->
                <circle class="fire-dot" cx="215" cy="150" r="3.5" fill="#facc15" fill-opacity="0.9" />
                <circle cx="215" cy="150" r="7" fill="url(#fireGlow)" fill-opacity="0.3" />
              </g>

            </g>

            <!-- hover ring -->
            <circle cx="210" cy="210" r="175" fill="none"
                    stroke="#22d3ee" stroke-opacity="0"
                    stroke-width="2"
                    class="transition-all duration-500 group-hover:stroke-opacity-30" />
          </svg>
        </a>
      </div>

    </div>
  </section>

  <!-- ══════════════════════ ABOUT ══════════════════════ -->
  <section id="about" class="border-t border-slate-800/80 bg-space-900/60 py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-cyan-500/25 bg-cyan-500/6 text-cyan-400 text-xs font-mono mb-8">
        <i data-lucide="layers" class="w-3.5 h-3.5"></i>
        Methodology
      </div>

      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-6">
        How the harmonization works
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mt-10">
        <div class="p-5 rounded-2xl bg-space-800/60 border border-slate-800/80 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-orange-500/10 border border-orange-500/25 flex items-center justify-center text-orange-400">
            <i data-lucide="database" class="w-5 h-5"></i>
          </div>
          <h3 class="font-bold text-white text-sm">1 — Ingest</h3>
          <p class="text-xs text-slate-400 leading-relaxed">Raw MODIS MCD14ML (1 km) and VIIRS VNP14IMGTDL (375 m) fire detections ingested directly into Supabase PostgreSQL.</p>
        </div>
        <div class="p-5 rounded-2xl bg-space-800/60 border border-slate-800/80 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/25 flex items-center justify-center text-cyan-400">
            <i data-lucide="git-merge" class="w-5 h-5"></i>
          </div>
          <h3 class="font-bold text-white text-sm">2 — Harmonize</h3>
          <p class="text-xs text-slate-400 leading-relaxed">Grid-based spatial join (0.1° cells) aligns both sensors. A weighted FRP formula yields a single HarmonizedCount per cell per month.</p>
        </div>
        <div class="p-5 rounded-2xl bg-space-800/60 border border-slate-800/80 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/25 flex items-center justify-center text-emerald-400">
            <i data-lucide="globe-2" class="w-5 h-5"></i>
          </div>
          <h3 class="font-bold text-white text-sm">3 — Visualize</h3>
          <p class="text-xs text-slate-400 leading-relaxed">An interactive 3D satellite globe (globe.gl + Three.js) renders thermal columns and pulsing rings live from the harmonized dataset.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════ FOOTER ══════════════════════ -->
  <footer class="border-t border-slate-800/80 py-8 px-6">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-600 font-mono">
      <span>© 2026 NasaSpaceAppsChallenge – Lachezar &amp; Mitko</span>
      <div class="flex items-center gap-4">
        <span>MODIS + VIIRS Harmonization</span>
        <a href="https://github.com/1achezar/Harmonization-of-MODIS-and-VIIRS-Hot-Spots" target="_blank" rel="noopener"
           class="hover:text-slate-400 transition flex items-center gap-1">
          <i data-lucide="github" class="w-3.5 h-3.5"></i> GitHub
        </a>
      </div>
    </div>
  </footer>

  <script>
    if (typeof lucide !== 'undefined') lucide.createIcons();
  </script>
</body>
</html>
